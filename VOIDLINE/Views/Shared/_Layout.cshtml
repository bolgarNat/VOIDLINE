<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>VOIDLINE</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/VOIDLINE.styles.css" asp-append-version="true" />
</head>
<body>
    <!-- Header -->
    <header class="navbar">
        <div class="navbar-item item-1" onclick="sidebar_change()">
            <span>
                <img src="~/icons/Menu_Icon.png" />
            </span>
        </div>
        <div class="navbar-item item-2">
            VOIDLINE
        </div>
        <div class="navbar navbar-item item-3">
            <span>
                <img src="~/icons/Account_Icon.png" />
            </span>
        </div>
        <div class="navbar navbar-item item-4">
            <span>
                <img src="~/icons/Basket_Icon.png" />
            </span>
        </div>
    </header>

    <!-- Sidebar -->
    <aside>
        <partial name="_Sidebar" />
    </aside>

    <!-- Body -->
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <!-- Footer -->
    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - VOIDLINE
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
