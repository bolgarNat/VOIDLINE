@model RegistrationModel

<div class="container-page-login">
	<div class="container-login">
		<div class="login-header">
			REGISTRATION
		</div>
		<form asp-controller="Registration"
			  asp-action="Register"
			  method="post">

			<label asp-for="Name">Name</label>
			<input type="text" asp-for="Name" placeholder="Your name" value="ew">
			<span asp-validation-for="Name"></span>

			<label asp-for="Surname">Surname</label>
			<input type="text" asp-for="Surname" placeholder="Your surname" value="ew">
			<span asp-validation-for="Surname"></span>

			<label asp-for="Email">Email</label>
			<input type="text" asp-for="Email" placeholder="email@gmail.com" value="ewwe@gmail.com">
			<span asp-validation-for="Email"></span>

			<label asp-for="Password">Password</label>
			<input type="text" asp-for="Password" placeholder="*******" value="ew123sdfgh">
			<span asp-validation-for="Password"></span>

			<a asp-controller="Login" asp-action="Login">
				<p>Already have an account?</p>
			</a>

			<div class="validation-error" style="padding-left:3px; font-size:14pt;">@ViewData["RegisterError"]</div>

			<div class="validation-error" style="padding-left:3px; font-size:14pt;">@ViewData["SendEmailError"]</div>

			<input type="submit" value="Enter">
		</form>
	</div>
</div>

<!-- Modal Code varification -->
@if (TempData["CodeVarification"] is true)
{
	<partial name="Modal/CodeVarification" />
}