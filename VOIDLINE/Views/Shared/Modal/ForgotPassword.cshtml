@model EmailModel

<div class="modal-overlay active" id="fp_modal">
	<div class="modal">
		<div class="container-add-to-basket">
			<button style="font-size: 12pt;" onclick="change_fp_modal_visability()">
				×
			</button>
		</div>

		<p style="font-size: 14pt">Enter your email to get a message with code</p>

		<form asp-controller="Login"
			  asp-action="ForgotPassword"
			  method="post"
			  id="forgot_password_form">
			<label>Email</label>
			<input type="text" name="Email" placeholder="email@gmail.com">
			<span asp-validation-for="Email"></span>

			<div class="validation-error" style="padding-left:3px; font-size:14pt;">@ViewData["EmailNotFound"]</div>

			<input type="submit" value="Enter">
		</form>
	</div>
</div>