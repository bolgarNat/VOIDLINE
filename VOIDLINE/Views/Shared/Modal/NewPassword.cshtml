@model PasswordModel

<div class="modal-overlay active" id="np_modal">
	<div class="modal">
		<div class="container-add-to-basket">
			<button style="font-size: 12pt;" onclick="change_np_modal_visability()">
				×
			</button>
		</div>

		<p style="font-size: 14pt">Enter new password</p>

		<form asp-controller="Login"
			  asp-action="NewPassword"
			  method="post">
			<label>New password</label>
			<input type="password" name="Password" placeholder="*******">
			<span asp-validation-for="Password"></span>

			<label>Repeat password</label>
			<input type="password" name="ConfirmPassword" placeholder="*******">
			<span asp-validation-for="ConfirmPassword"></span>

			<div class="validation-error" style="padding-left:3px; font-size:14pt;">@ViewData["PasswordError"]</div>

			<input type="submit" value="Enter">
		</form>
	</div>
</div>