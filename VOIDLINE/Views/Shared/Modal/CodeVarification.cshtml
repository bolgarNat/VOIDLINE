

<div class="modal-overlay active" id="cv_modal">
	<div class="modal">
		<div class="container-add-to-basket">
			<button style="font-size: 12pt;" onclick="change_cv_modal_visability()">
				×
			</button>
		</div>

		<p style="font-size: 14pt">Please enter the 4-digit verification code we sent via email</p>

		<form asp-controller="@TempData["ControllerName"]"
			  asp-action="CodeVarification"
			  method="post">

			<div class="container-cv">
				<input type="text" class="cv" name="digit1" maxLength="1" size="1" min="0" max="9" pattern="[0-9]{1}" />
				<input type="text" class="cv" name="digit2" maxLength="1" size="1" min="0" max="9" pattern="[0-9]{1}" />
				<input type="text" class="cv" name="digit3" maxLength="1" size="1" min="0" max="9" pattern="[0-9]{1}" />
				<input type="text" class="cv" name="digit4" maxLength="1" size="1" min="0" max="9" pattern="[0-9]{1}" />

			</div>

			<div class="validation-error" style="padding-left:3px; font-size:11pt;">@TempData["CodeError"]</div>

			<a onclick="@TempData["ChangeEmailOnClick"]">
				<p>Change email</p>
			</a>

			<a onclick="send_form()">
				<p>Resend code</p>
			</a>

			<input type="submit" value="Enter">
		</form>

		<form asp-controller="@TempData["ControllerName"]"
			  asp-action="@TempData["ActionName"]"
			  method="post"
			  id="resend_code">

			<input type="hidden" name="email" value="@TempData["Email"]">
		</form>
	</div>
</div>