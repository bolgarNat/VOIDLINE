@using VOIDLINE.Models.Database

<html>
    <body>
        <div class="sidebar" id="sidebar">

            <p style="font-size: 22pt">NEW</p>
            <p style="font-size: 22pt; margin-bottom: 15px">Collaboration</p>

            @foreach (var categoryVariant in (List<Categoryvariant>)ViewData["Category"]!)
            {
                <p style="font-size: 16pt; margin-top: 15px">@categoryVariant.Name</p>

                @foreach (var category in categoryVariant.Categories)
                {
                    <p>@category.Name</p>
                }
            }
        </div>
    </body>
</html>
