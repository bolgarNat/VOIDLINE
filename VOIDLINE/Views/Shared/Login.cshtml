@model LoginModel

<div class="container-page-login">
	<div class="container-login">
		<div class="login-header">
			LOG IN
		</div>
		<form asp-controller="Login" asp-action="LogIn" method="post">

			<label asp-for="Email">Email</label>
			<input type="text" asp-for="Email" placeholder="email@gmail.com">
			<span asp-validation-for="Email"></span>

			<label asp-for="Password">Password</label>
			<input type="password" asp-for="Password" placeholder="*******">
			<span asp-validation-for="Password"></span>

			<a asp-controller="Login" asp-action="OpenForgetPassword">
				<p>Forget password?</p>
			</a>

			<a asp-controller="Registration" asp-action="Registration">
				<p>Do not have an account?</p>
			</a>

			<div class="validation-error" style="padding-left:3px; font-size:14pt;">@ViewData["LoginError"]</div>
				
			<div class="validation-error" style="padding-left:3px; font-size:14pt;">@ViewData["SendEmailError"]</div>
			
			<input type="submit" value="Enter">
		</form>
	</div>

	@ViewData["CodeVarification"]
</div>

<!-- Modal Forgot password -->
@if (TempData["ForgotPassword"] is true)
{
	<partial name="Modal/ForgotPassword"
			 model="@(new EmailModel())" />
}

<!-- Modal new password -->
@if (TempData["NewPassword"] is true)
{
	<partial name="Modal/NewPassword"
			 model="@(new PasswordModel())" />
}



<!-- Modal Code varification -->
@if (TempData["CodeVarification"] is true)
{
	<partial name="Modal/CodeVarification" />
}