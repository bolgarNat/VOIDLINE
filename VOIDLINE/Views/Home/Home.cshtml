@using VOIDLINE.Models.Database

<html>
	<body>
		<div class="cardfilter-container">
		<div class="filter-part">FILTER<br />FILTER<br />FILTER<br />FILTER<br />FILTER<br />FILTER<br />FILTER</div>
			<div class="card-container">
				@foreach (var product in (List<Product>)ViewData["Product"]!)
				{
					<div class="product-card">
					<img class="card-img" src="~/Photos/Houndstooth_tweed_blazer/pexels-frandany-227885104-13202131.jpg" />
						<div class="card-colors"></div>
					<p class="card-info" style="font-size: 18px; margin-top: 10px">@product.Name</p>
					<p class="card-info" style="font-size: 16px; margin-bottom: 10px">@product.Price</p>
					<div class="container-add-to-basket" id="add_button_container">
						<button class="button-add-to-basket" onclick="change_amount()">Add</button>
					</div>
					<div class="container-change-amount" style="visibility: hidden" id="container-change-amount">
						<button class="button-add-one">+</button>
						<div class="text-amount">Количество</div>
						<button class="button-delete-one">-</button>
					</div>
					</div>
				}
			</div>
		</div>
	</body>
</html>