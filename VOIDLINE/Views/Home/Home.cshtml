@using VOIDLINE.Models.Database

<html>
	<body>
		<div class="cardfilter-container">
			<div class="filter-part"></div>
			<div class="card-container">
				@foreach (var product in (List<Product>)ViewData["Product"]!)
				{
					<div class="product-card">
						<div class="card-img"></div>
						<div class="card-colors"></div>
					<p class="card-info" style="font-size: 18px; margin-top: 10px">@product.Name</p>
						<p class="card-info" style="font-size: 16px; margin-bottom: 10px">Цена</p>
						<div class="container-add-to-basket">
							<button class="card-add-to-basket" style="font-size: 24px">Add</button>
						</div>
					
					</div>
				}
			</div>
		</div>
	</body>
</html>